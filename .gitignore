# ─── Node ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Environment variables ────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample
# Allow production env files to be committed (needed for Render build)
!.env.production
!client/.env.production

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log

# ─── Uploads (user-uploaded files / images) ──────────────────────
uploads/

# ─── Local MongoDB data ───────────────────────────────────────────
mongodata/

# ─── Old server build output ─────────────────────────────────────
server/public/

# ─── Root-level images (duplicate of client/public/images) ───────
images/

# ─── OS files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / Editor ────────────────────────────────────────────────
.vscode/
.idea/
*.sw?
